<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />

  <PropertyGroup Label="UserMacros">
    <AYLogDir>$(SolutionDir)3rdParty</AYLogDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)'=='Win32'">
    <AYLogArch>lib32</AYLogArch>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <AYLogArch>lib64</AYLogArch>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <AYLogLib>libd</AYLogLib>
    <AYLogSpecificLib>fmtd.lib;spdlogd.lib</AYLogSpecificLib>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <AYLogLib>lib</AYLogLib>
    <AYLogSpecificLib>fmt.lib;spdlog.lib</AYLogSpecificLib>
  </PropertyGroup>

  <!-- ========================================== -->
  <!-- 4. 统一构建规则 -->
  <!-- ========================================== -->
  <ItemDefinitionGroup>
    <ClCompile>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- UserMacro -->
      <PreprocessorDefinitions>SPDLOG_WCHAR_TO_UTF8_SUPPORT;SPDLOG_WCHAR_FILENAMES;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Include -->
      <AdditionalIncludeDirectories>$(SolutionDir);$(AYLogDir)\include;$(AYLogDir)\$(AYLogArch)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Compilation -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <!-- lib -->
      <AdditionalLibraryDirectories>$(AYLogDir)\$(AYLogArch)\$(AYLogLib);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>jsoncpp.lib;$(AYLogSpecificLib);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup />
</Project>
