<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  
  <PropertyGroup Label="UserMacros">
    <ThirdPartyDir>$(SolutionDir)3rdParty</ThirdPartyDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)'=='Win32'">
    <ThirdPartyArch>lib32</ThirdPartyArch>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <ThirdPartyArch>lib64</ThirdPartyArch>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <ThirdPartyLib>libd</ThirdPartyLib>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <ThirdPartyLib>lib</ThirdPartyLib>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- Include -->
      <AdditionalIncludeDirectories>$(SolutionDir);$(ThirdPartyDir)\include;$(ThirdPartyDir)\$(ThirdPartyArch)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- lib -->
      <AdditionalLibraryDirectories>$(ThirdPartyDir)\$(ThirdPartyArch)\$(ThirdPartyLib);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  
  <ItemGroup />
</Project>
